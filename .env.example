# Porchlight configuration. Copy this file to .env and fill it in.
# Never commit .env or share it: it holds your secret key and passwords.

# ---------------------------------------------------------------- required

# A long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
PORCHLIGHT_SECRET_KEY=

# The address people use to reach Porchlight (used in emails, invoices, calendar links).
# Its host name is allowed automatically.
PORCHLIGHT_BASE_URL=https://hoa.example.com

# Your time zone (dues dates, reminders, daily tasks).
PORCHLIGHT_TIME_ZONE=America/New_York

# ---------------------------------------------------------------- behind a reverse proxy
# Synology DSM reverse proxy, Caddy, nginx, Traefik... (recommended, for HTTPS)

PORCHLIGHT_BEHIND_PROXY=1
# How many proxies are in front of Porchlight: DSM reverse proxy alone = 1;
# Cloudflare in front of DSM = 2 (only if the NAS accepts connections from Cloudflare alone).
# Used to find visitors' real IP for rate limits.
PORCHLIGHT_TRUSTED_PROXY_COUNT=1

# Extra host names or origins, comma-separated (usually not needed).
# PORCHLIGHT_ALLOWED_HOSTS=192.168.1.20
# PORCHLIGHT_CSRF_TRUSTED_ORIGINS=https://other-name.example.com

# Only for local testing over plain http (no HTTPS): set to 0 so sign-in cookies work.
# PORCHLIGHT_SECURE_COOKIES=0

# ---------------------------------------------------------------- email
# Needed for sign-in links, invoices and reminders. Any SMTP service works
# (your email provider, Fastmail, Postmark, Amazon SES, ...).

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Our HOA <hoa@example.com>

# ---------------------------------------------------------------- first-run setup
# The setup page asks for a token so a stranger can't claim a fresh install.
# If you leave this blank, a random one is printed in the web container's log and
# saved as setup-token.txt in the data folder.
# PORCHLIGHT_SETUP_TOKEN=

# ---------------------------------------------------------------- container

# Port on the host for the web container.
PORCHLIGHT_PORT=8000
# Which host address the port listens on. 127.0.0.1 (the default) means only the NAS itself,
# which is all its reverse proxy needs. Use 0.0.0.0 only if your proxy runs on another
# machine, or to test over your network; never forward the port on your router.
# PORCHLIGHT_BIND=127.0.0.1
# Owner of files in ./data. On Synology, use your DSM user's IDs (run `id` over SSH),
# e.g. PUID=1026 and PGID=100.
PUID=1000
PGID=1000
# Pin a version instead of latest, e.g. tachyonflux/porchlight:1.0
# PORCHLIGHT_IMAGE=tachyonflux/porchlight:latest
# Web server processes and threads (defaults suit a small NAS).
# PORCHLIGHT_WEB_WORKERS=2
# PORCHLIGHT_WEB_THREADS=4

# ---------------------------------------------------------------- daily tasks & backups

# Hour (local time, 0-23) the scheduler runs reminders, invoices, cleanups and backups.
PORCHLIGHT_DAILY_TASKS_HOUR=6
# How many daily database copies to keep in data/backups (SQLite only; 0 = off).
PORCHLIGHT_BACKUP_KEEP=14

# ---------------------------------------------------------------- uploads
# Largest single file (MB) and largest whole request (MB). Your reverse proxy must
# allow at least the request size too.
PORCHLIGHT_MAX_UPLOAD_MB=15
PORCHLIGHT_MAX_REQUEST_MB=60

# ---------------------------------------------------------------- optional: PostgreSQL
# SQLite (the default) is right for one neighborhood. To use PostgreSQL instead, set all
# three lines (the same password in both places):
# COMPOSE_PROFILES=postgres
# POSTGRES_PASSWORD=
# DATABASE_URL=postgres://porchlight:THE_SAME_PASSWORD@db:5432/porchlight

# ---------------------------------------------------------------- optional: SimpleFIN bank sync
# Read-only bank transaction sync through SimpleFIN Bridge (a paid third-party service).
# File import (CSV/OFX) works without it. The encryption key protects the saved
# connection; generate one with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy somewhere safe: without it the saved connection can't be read.
# PORCHLIGHT_SIMPLEFIN_ENABLED=1
# PORCHLIGHT_ENCRYPTION_KEY=

# ---------------------------------------------------------------- rarely needed

# Django's admin site (TOTP required). Off by default.
# PORCHLIGHT_ENABLE_DJANGO_ADMIN=0
# Name shown in authenticator apps for two-step sign-in.
# PORCHLIGHT_OTP_ISSUER=Porchlight
# PORCHLIGHT_LOG_LEVEL=INFO
# Never enable on a real server.
# PORCHLIGHT_DEBUG=0
